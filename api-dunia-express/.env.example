# Application Environment
PORT=3000
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/dunia_express?sslmode=disable

# Security & Hashing
SALT_ROUNDS=12

# JWT Configuration (Use strong random keys with min 32 characters in production)
JWT_ACCESS_SECRET=replace_with_a_secure_random_access_secret_key_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_key_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=dunia-express-api
JWT_AUDIENCE=dunia-express-client

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# CORS & Client Origin
FRONTEND_ORIGIN=http://localhost:5173
